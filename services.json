/**
 * APPS_SCRIPT_SUBMIT_LEAD.js
 * ─────────────────────────────────────────────────────────────────────────────
 * Google Apps Script for the High Tier Submit Outbound Lead form.
 *
 * HOW TO INSTALL:
 * 1. Open the High Tier client workbook in Google Sheets.
 * 2. Click Extensions → Apps Script.
 * 3. Delete any existing code in Code.gs.
 * 4. Paste this entire file into Code.gs.
 * 5. Click Save (floppy disk icon).
 * 6. Click Run → onOpen (to test and grant permissions).
 * 7. Approve all requested permissions.
 * 8. Close Apps Script editor.
 * 9. Reload the spreadsheet — you should see "📞 Submit Lead" in the menu bar.
 * 10. Go to Submit Outbound Lead tab and test with a safe test phone number.
 */

// ── Configuration ─────────────────────────────────────────────────────────────

// These values are pre-filled for each client workbook.
// Do not change unless instructed by the backend team.
const CONFIG = {
  QUEUE_TAB_NAME:  'Outbound Queue',
  SUBMIT_TAB_NAME: 'Submit Outbound Lead',
  
  BLOCKED_RELATIONSHIP_TYPES: [
    'Scraped Lead', 'Purchased List', 'Unknown Source', 'Random Prospect', 'Cold List'
  ],
  BLOCKED_CONSENT_STATUSES: [
    'Unknown', 'Rejected', 'Do Not Call', 'No Consent'
  ],
  ALLOWED_CAMPAIGN_TYPES: [
    'missed_call_recovery', 'inbound_lead_followup', 'quote_followup',
    'calendly_not_booked', 'appointment_confirmation', 'no_show_recovery',
    'review_request', 'existing_customer_reactivation'
  ],
};

// ── Menu setup ────────────────────────────────────────────────────────────────

function onOpen() {
  SpreadsheetApp.getUi()
    .createMenu('📞 Submit Lead')
    .addItem('Submit Outbound Lead', 'submitOutboundLead')
    .addSeparator()
    .addItem('View Queue Status', 'viewQueueStatus')
    .addItem('Clear Form', 'clearForm')
    .addToUi();
}

// ── Main submit function ──────────────────────────────────────────────────────

function submitOutboundLead() {
  const ui     = SpreadsheetApp.getUi();
  const ss     = SpreadsheetApp.getActiveSpreadsheet();
  const submit = ss.getSheetByName(CONFIG.SUBMIT_TAB_NAME);

  if (!submit) {
    ui.alert('❌ Error', `Tab "${CONFIG.SUBMIT_TAB_NAME}" not found. Contact support.`, ui.ButtonSet.OK);
    return;
  }

  // ── Read form fields ─────────────────────────────────────────────────────
  const leadName            = String(submit.getRange('B3').getValue()).trim();
  const phoneNumber         = String(submit.getRange('B4').getValue()).trim();
  const email               = String(submit.getRange('B5').getValue()).trim();
  const campaignType        = String(submit.getRange('B6').getValue()).trim();
  const serviceInterest     = String(submit.getRange('B7').getValue()).trim();
  const desiredOutcome      = String(submit.getRange('B8').getValue()).trim();
  const relationshipType    = String(submit.getRange('B9').getValue()).trim();
  const consentStatus       = String(submit.getRange('B10').getValue()).trim();
  const consentSource       = String(submit.getRange('B11').getValue()).trim();
  const lastInteractionDate = submit.getRange('B12').getValue();
  const preferredCallWindow = String(submit.getRange('B13').getValue()).trim();
  const notes               = String(submit.getRange('B14').getValue()).trim();
  const clientAttestation   = submit.getRange('B15').getValue();

  // ── Validation ────────────────────────────────────────────────────────────
  const errors = [];

  if (!leadName)         errors.push('• Lead Name is required');
  if (!phoneNumber)      errors.push('• Phone Number is required');
  if (phoneNumber && !isValidPhone(phoneNumber)) errors.push('• Phone Number is invalid (must be 10+ digits)');
  if (!campaignType)     errors.push('• Campaign Type is required');
  if (!desiredOutcome)   errors.push('• Desired Outcome is required');
  if (!relationshipType) errors.push('• Relationship Type is required');
  if (!consentStatus)    errors.push('• Consent Status is required');

  if (clientAttestation !== true && clientAttestation !== 'TRUE' && clientAttestation !== true) {
    errors.push('• Client Attestation must be checked (TRUE)');
  }

  if (campaignType && !CONFIG.ALLOWED_CAMPAIGN_TYPES.includes(campaignType)) {
    errors.push(`• Campaign Type "${campaignType}" is not permitted`);
  }

  if (CONFIG.BLOCKED_RELATIONSHIP_TYPES.includes(relationshipType)) {
    errors.push(`• Relationship Type "${relationshipType}" is BLOCKED — only permitted contacts may be called`);
  }

  if (CONFIG.BLOCKED_CONSENT_STATUSES.includes(consentStatus)) {
    errors.push(`• Consent Status "${consentStatus}" is BLOCKED — cannot call this contact`);
  }

  if (desiredOutcome && desiredOutcome.length < 10) {
    errors.push('• Desired Outcome is too short — describe what you want the AI to accomplish');
  }

  // Check DNC list
  if (phoneNumber && isOnDNCList(ss, phoneNumber)) {
    errors.push(`• ❌ BLOCKED: ${phoneNumber} is on the Do Not Call list`);
  }

  if (errors.length > 0) {
    ui.alert(
      '⚠️ Validation Failed',
      'Please fix the following before submitting:\n\n' + errors.join('\n'),
      ui.ButtonSet.OK
    );
    return;
  }

  // ── Generate lead ID ──────────────────────────────────────────────────────
  const leadId    = 'LEAD-' + new Date().getTime();
  const submitted = new Date().toISOString();

  // ── Append to Outbound Queue ──────────────────────────────────────────────
  const queueSheet = ss.getSheetByName(CONFIG.QUEUE_TAB_NAME);
  if (!queueSheet) {
    ui.alert('❌ Error', `Tab "${CONFIG.QUEUE_TAB_NAME}" not found. Contact support.`, ui.ButtonSet.OK);
    return;
  }

  const normalizedPhone = normalizePhone(phoneNumber);

  queueSheet.appendRow([
    leadId,                     // A: lead_id
    leadName,                   // B: lead_name
    normalizedPhone,            // C: phone_number
    email,                      // D: email
    'Client Submitted',         // E: source
    campaignType,               // F: campaign_type
    serviceInterest,            // G: service_interest
    '',                         // H: call_reason (filled by AI on call)
    desiredOutcome,             // I: desired_outcome
    relationshipType,           // J: relationship_type
    consentStatus,              // K: consent_status
    consentSource,              // L: consent_source
    lastInteractionDate ? Utilities.formatDate(new Date(lastInteractionDate), 'America/Chicago', 'yyyy-MM-dd') : '', // M
    preferredCallWindow,        // N: preferred_call_window
    '',                         // O: call_window_start (optional override)
    '',                         // P: call_window_end (optional override)
    0,                          // Q: attempt_count
    3,                          // R: max_attempts
    'Pending Validation',       // S: status
    'Normal',                   // T: priority
    false,                      // U: opt_out
    true,                       // V: client_attestation
    'Pending',                  // W: validation_status
    '',                         // X: validation_notes
    notes,                      // Y: notes
    submitted,                  // Z: lead_submitted_at
    submitted,                  // AA: last_updated
  ]);

  // ── Clear form fields ─────────────────────────────────────────────────────
  clearForm();

  // ── Success message ───────────────────────────────────────────────────────
  ui.alert(
    '✅ Lead Submitted Successfully!',
    `Lead ID: ${leadId}\n\nThe system will validate this lead and queue it for calling.\n` +
    `Status will update in the Outbound Queue tab.\n\n` +
    `Note: If outbound_mode is set to "manual", trigger a worker run to start calls.`,
    ui.ButtonSet.OK
  );
}

// ── View queue status ─────────────────────────────────────────────────────────

function viewQueueStatus() {
  const ui          = SpreadsheetApp.getUi();
  const ss          = SpreadsheetApp.getActiveSpreadsheet();
  const queueSheet  = ss.getSheetByName(CONFIG.QUEUE_TAB_NAME);

  if (!queueSheet) {
    ui.alert('Queue tab not found.');
    return;
  }

  const data    = queueSheet.getDataRange().getValues();
  const rows    = data.slice(1); // skip header
  const total   = rows.length;
  const ready   = rows.filter(r => r[18] === 'Ready').length;
  const blocked = rows.filter(r => r[18] === 'Blocked').length;
  const booked  = rows.filter(r => r[18] === 'Booked').length;
  const opted   = rows.filter(r => r[18] === 'Opted Out').length;
  const pending = rows.filter(r => r[18] === 'Pending Validation').length;

  ui.alert(
    '📊 Outbound Queue Status',
    `Total in queue:        ${total}\n` +
    `Pending Validation:    ${pending}\n` +
    `Ready to Call:         ${ready}\n` +
    `Blocked:               ${blocked}\n` +
    `Booked:                ${booked}\n` +
    `Opted Out:             ${opted}`,
    ui.ButtonSet.OK
  );
}

// ── Clear form ────────────────────────────────────────────────────────────────

function clearForm() {
  const ss     = SpreadsheetApp.getActiveSpreadsheet();
  const submit = ss.getSheetByName(CONFIG.SUBMIT_TAB_NAME);
  if (!submit) return;

  ['B3','B4','B5','B6','B7','B8','B9','B10','B11','B12','B13','B14'].forEach(cell => {
    submit.getRange(cell).clearContent();
  });
  submit.getRange('B15').setValue(false); // uncheck attestation
}

// ── Validation helpers ────────────────────────────────────────────────────────

function isValidPhone(phone) {
  const digits = phone.replace(/\D/g, '');
  return digits.length >= 10 && digits.length <= 15;
}

function normalizePhone(phone) {
  const digits = phone.replace(/\D/g, '');
  if (digits.length === 10) return '+1' + digits;
  if (digits.length === 11 && digits.startsWith('1')) return '+' + digits;
  return phone;
}

function isOnDNCList(ss, phone) {
  try {
    const dncSheet = ss.getSheetByName('Do Not Call / Opt-Outs');
    if (!dncSheet) return false;

    const data   = dncSheet.getDataRange().getValues();
    const digits = phone.replace(/\D/g, '');

    return data.slice(1).some(row => {
      const rowDigits = String(row[1]).replace(/\D/g, '');
      return rowDigits === digits && rowDigits.length >= 10;
    });
  } catch (e) {
    Logger.log('DNC check error: ' + e);
    return false;
  }
}
