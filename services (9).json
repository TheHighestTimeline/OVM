function buildBusinessInfoTab(ss) {
  var s = getOrCreateSheet(ss, 'Business Info');
  s.clearContents();
  var labels = [
    ['Business Name',''],['Owner Name',''],['Owner Email',''],['Owner Phone',''],
    ['Business Phone (Twilio #)',''],['Agent Name','Alex'],
    ['Business Hours Start','08:00'],['Business Hours End','18:00'],
    ['Time Zone','America/Chicago'],['Calendly Link (General)',''],
    ['Primary Service',''],['Address',''],['Package',''],
    ['Business ID',''],['Tier','low'],['Google Sheet ID','(auto-filled)']
  ];
  for (var i = 0; i < labels.length; i++) {
    s.getRange(i+1, 1).setValue(labels[i][0]).setFontWeight('bold').setBackground('#f5f5f5');
    s.getRange(i+1, 2).setValue(labels[i][1]);
  }
  s.setColumnWidth(1, 220);
  s.setColumnWidth(2, 350);
  s.getRange('A1:A16').setBackground('#e8eaf6');
}

function buildCallLogTab(ss, tier) {
  var s = getOrCreateSheet(ss, 'Call Log');
  s.clearContents();
  var headers = [
    'call_id','call_date','call_time','caller_name','caller_phone','caller_email',
    'language','service_requested','call_outcome','lead_score','lead_priority',
    'is_new_customer','urgency','caller_intent','call_reason',
    'calendly_link_sent','callback_needed','human_handoff_needed','is_spam',
    'ai_summary','next_action','assigned_to','notes'
  ];
  if (tier === 'medium' || tier === 'high') {
    headers = headers.concat(['intent_confidence','dynamic_questions_asked','lost_lead_risk','lost_lead_reason','recording_sid']);
  }
  if (tier === 'high') {
    headers = headers.concat(['direction','campaign_type','lead_id']);
  }
  setHeaders(s, headers, '#1a1a2e', '#ffffff');
  s.setFrozenRows(1);
  s.getRange('A1:1').setFontWeight('bold');
}

