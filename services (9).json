function buildSubmitLeadTab(ss) {
  var s = getOrCreateSheet(ss, 'Submit Outbound Lead');
  s.clearContents();

  // Title
  s.getRange('A1:C1').merge().setValue('📞 Submit Outbound Lead').setFontSize(16).setFontWeight('bold').setBackground('#1a1a2e').setFontColor('#ffffff').setHorizontalAlignment('center');

  var fields = [
    ['Lead Name *', ''],
    ['Phone Number *', ''],
    ['Email Address', ''],
    ['Campaign Type *', ''],
    ['Service Interest', ''],
    ['Desired Outcome *', ''],
    ['Relationship Type *', ''],
    ['Consent Status *', ''],
    ['Consent Source', ''],
    ['Last Interaction Date', ''],
    ['Preferred Call Window', ''],
    ['Notes', ''],
    ['✅ Client Attestation *', false],
  ];

  for (var i = 0; i < fields.length; i++) {
    var row = i + 3;
    s.getRange(row, 1).setValue(fields[i][0]).setFontWeight('bold').setBackground('#f5f5f5');
    s.getRange(row, 2).setValue(fields[i][1]).setBackground('#ffffff');
    if (fields[i][0].indexOf('*') > -1) {
      s.getRange(row, 1).setBackground('#e8eaf6');
    }
  }

  // Attestation text
  s.getRange('A16:C16').merge()
    .setValue('I certify I have a legitimate, lawful basis to contact this individual. This is NOT a cold lead, scraped contact, or purchased list.')
    .setFontStyle('italic').setFontColor('#666666').setWrap(true);

  // Submit button area
  s.getRange('B17').setValue('← Click "📞 Submit Lead" in the top menu to submit')
    .setFontStyle('italic').setFontColor('#3a5bd9');

  // Dropdowns
  var campaignRule = SpreadsheetApp.newDataValidation().requireValueInList([
    'missed_call_recovery','inbound_lead_followup','quote_followup',
    'calendly_not_booked','appointment_confirmation','no_show_recovery',
    'review_request','existing_customer_reactivation'
  ], true).build();
  s.getRange('B6').setDataValidation(campaignRule);

  var relationshipRule = SpreadsheetApp.newDataValidation().requireValueInList([
    'Missed Caller','Inbound Lead','Website Form Lead','Text/Email Responded',
    'Quote Request','Existing Customer','Past Customer','No-Show',
    'Appointment Holder','Review Request','Referral With Permission','Manual Review Approved'
  ], true).build();
  s.getRange('B9').setDataValidation(relationshipRule);

  var consentRule = SpreadsheetApp.newDataValidation().requireValueInList([
    'Approved','Prior Inquiry','Existing Customer','Appointment Related',
    'Quote Requested','Manual Review Approved'
  ], true).build();
  s.getRange('B10').setDataValidation(consentRule);

  // Checkbox for attestation
  s.getRange('B15').insertCheckboxes();

  s.setColumnWidth(1, 220);
  s.setColumnWidth(2, 320);
}

function buildCampaignInputsTab(ss) {
  var s = getOrCreateSheet(ss, 'Business / Campaign Inputs');
  s.clearContents();
  setHeaders(s, ['campaign_type','campaign_display_name','approved_opener','approved_questions','active_promotion','seasonal_note','max_attempts','call_window_start','call_window_end','notes'], '#1a1a2e', '#ffffff');
  var examples = [
    ['missed_call_recovery','Missed Call Recovery','Hi [LEAD_NAME], this is [AGENT_NAME] calling from [BUSINESS_NAME]. I saw you tried to reach us and wanted to make sure we got back to you. Do you have a quick moment?','What were you hoping we could help you with today?|Is this something urgent or can we schedule at your convenience?','','',3,'09:00','18:00','Most common campaign'],
