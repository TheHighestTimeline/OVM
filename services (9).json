/**
 * SETUP_ALL_SHEETS.js
 * ─────────────────────────────────────────────────────────────────────────────
 * Run this ONE TIME in the Master Backend sheet.
 * It will:
 *   1. Set up Master Backend tabs + headers
 *   2. Create the Low Tier template workbook
 *   3. Create the Medium Tier template workbook
 *   4. Create the High Tier template workbook
 *
 * HOW TO USE:
 *   1. Open your "Voice Agent + Master Backend" Google Sheet
 *   2. Click Extensions → Apps Script
 *   3. Delete all existing code
 *   4. Paste this entire file
 *   5. Click Save
 *   6. Click Run → setupEverything
 *   7. Approve permissions when prompted
 *   8. Wait ~60 seconds — you'll see an alert when done
 */

function setupEverything() {
  setupMasterBackend();
  var lowId    = createLowTierWorkbook();
  var mediumId = createMediumTierWorkbook();
  var highId   = createHighTierWorkbook();

  // Write the new sheet IDs into Master Backend for reference
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var ref = ss.getSheetByName('Sheet Reference');
  if (!ref) ref = ss.insertSheet('Sheet Reference');
  ref.clearContents();
  ref.getRange('A1:B1').setValues([['Workbook', 'Sheet ID']]);
  ref.getRange('A2:B4').setValues([
    ['Low Tier Template',    lowId],
    ['Medium Tier Template', mediumId],
    ['High Tier Template',   highId],
  ]);
  ref.getRange('A1:B1').setFontWeight('bold').setBackground('#1a1a2e').setFontColor('#ffffff');
  ref.setColumnWidth(1, 200);
  ref.setColumnWidth(2, 400);

  SpreadsheetApp.getUi().alert(
    '✅ Setup Complete!',
    'All 4 sheets are ready:\n\n' +
    '• Master Backend — this sheet\n' +
    '• Low Tier Template — ID: ' + lowId + '\n' +
    '• Medium Tier Template — ID: ' + mediumId + '\n' +
    '• High Tier Template — ID: ' + highId + '\n\n' +
    'Check the "Sheet Reference" tab for all IDs.\n' +
    'Check your Google Drive for the new workbooks.',
    SpreadsheetApp.getUi().ButtonSet.OK
  );
}

// ═══════════════════════════════════════════════════════════════════════════════
// MASTER BACKEND SETUP
// ═══════════════════════════════════════════════════════════════════════════════

function setupMasterBackend() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();

  // ── Client Roster ──────────────────────────────────────────────────────────
  var roster = getOrCreateSheet(ss, 'Client Roster');
  roster.clearContents();
  var rosterHeaders = [
    'business_id','business_name','owner_email','owner_phone','tier',
    'package_key','google_sheet_id','twilio_phone_number','agent_name',
    'calendly_link','business_hours_start','business_hours_end',
    'business_timezone','package_display','active','outbound_enabled',
    'outbound_mode','outbound_daily_limit','outbound_call_window_start',
    'outbound_call_window_end','outbound_timezone','monthly_outbound_limit',
    'outbound_calls_used_this_month'
  ];
  setHeaders(roster, rosterHeaders, '#1a1a2e', '#ffffff');
  setColumnWidths(roster, [150,200,220,150,80,120,350,180,100,280,120,120,180,120,70,120,200,120,180,180,180,150,200]);

  // Add demo row
  roster.getRange('A2:W2').setValues([[
    'test-biz-001','Test Business','your@email.com','','low',
    'starter-100','PASTE_CLIENT_SHEET_ID_HERE','+18135376102','Alex',
    'https://calendly.com/yourbusiness','08:00','18:00','America/Chicago',
    'Starter 100','TRUE','FALSE','paused',20,'09:00','18:00',
    'America/Chicago',100,0
  ]]);
  roster.getRange('A2:W2').setBackground('#e8f5e9');

  // ── Events Log ─────────────────────────────────────────────────────────────
  var events = getOrCreateSheet(ss, 'Events Log');
  events.clearContents();
  setHeaders(events, ['timestamp','event_type','business_id','metadata'], '#1a1a2e', '#ffffff');

  // ── Error Log ──────────────────────────────────────────────────────────────
  var errors = getOrCreateSheet(ss, 'Error Log');
  errors.clearContents();
  setHeaders(errors, ['timestamp','business_id','error_type','error_message','call_sid'], '#b71c1c', '#ffffff');

  // ── Usage Tracker ──────────────────────────────────────────────────────────
  var usage = getOrCreateSheet(ss, 'Usage Tracker');
  usage.clearContents();
  setHeaders(usage, ['month','business_id','business_name','tier','inbound_calls','inbound_minutes','outbound_calls','outbound_minutes','total_overage_cost'], '#1a1a2e', '#ffffff');

  // Delete default Sheet1 if it exists
  var sheet1 = ss.getSheetByName('Sheet1');
  if (sheet1 && ss.getSheets().length > 1) ss.deleteSheet(sheet1);

  // Format the whole workbook
  ss.setSpreadsheetName('Voice Agent — Master Backend');
}

// ═══════════════════════════════════════════════════════════════════════════════
// LOW TIER WORKBOOK
// ═══════════════════════════════════════════════════════════════════════════════

function createLowTierWorkbook() {
  var ss = SpreadsheetApp.create('LOW TIER TEMPLATE — Voice Agent (Starter)');
  var id = ss.getId();

  buildBusinessInfoTab(ss);
  buildCallLogTab(ss, 'low');
  buildNeedsAttentionTab(ss);
  buildAppointmentsTab(ss);
  buildFAQTab(ss);
  buildLeadScoringTab(ss, 'low');
  buildCalendlyTab(ss);
  buildDNCTab(ss);
  buildSMSLogTab(ss);
  buildMissedCallTab(ss);
  buildMonthlyUsageTab(ss, 'low');
  buildErrorLogTab(ss);

  // Remove default sheet
  var def = ss.getSheetByName('Sheet1');
  if (def && ss.getSheets().length > 1) ss.deleteSheet(def);

  ss.setActiveSheet(ss.getSheetByName('Business Info'));
  return id;
}

