// ═══════════════════════════════════════════════════════════════════════════════
// UTILITY FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

function getOrCreateSheet(ss, name) {
  var sheet = ss.getSheetByName(name);
  if (!sheet) sheet = ss.insertSheet(name);
  return sheet;
}

function setHeaders(sheet, headers, bgColor, fontColor) {
  var range = sheet.getRange(1, 1, 1, headers.length);
  range.setValues([headers])
       .setBackground(bgColor || '#1a1a2e')
       .setFontColor(fontColor || '#ffffff')
       .setFontWeight('bold')
       .setFrozenRows && sheet.setFrozenRows(1);
  sheet.setFrozenRows(1);
  for (var i = 0; i < headers.length; i++) {
    sheet.setColumnWidth(i + 1, Math.max(headers[i].length * 8 + 20, 100));
  }
}

function setColumnWidths(sheet, widths) {
  for (var i = 0; i < widths.length; i++) {
    sheet.setColumnWidth(i + 1, widths[i]);
  }
}

// Add menu on open
function onOpen() {
  SpreadsheetApp.getUi()
    .createMenu('🔧 Voice Agent Setup')
    .addItem('Run Full Setup (first time only)', 'setupEverything')
    .addToUi();
}
