/**
 * weeklyReporter.ts — Medium / High Tier
 * Generates and sends weekly performance reports for each qualifying client.
 */

import { readSheetTab, appendToSheet } from './googleSheets';
import { sendEmail } from './emailSender';
import { average, topN } from './utils';

export interface ClientConfig {
  businessId: string;
  businessName: string;
  ownerEmail: string;
  googleSheetId: string;
  tier: 'low' | 'medium' | 'high';
  weeklyReports: boolean;
  outboundSales?: boolean;
}

export interface WeeklyReport {
  report_id: string;
  week_ending: string;
  business_id: string;
  business_name: string;

  // Core metrics
  totalCalls: number;
  newLeads: number;
  highIntentLeads: number;
  appointmentsRequested: number;
  calendlyLinksSent: number;
  callbacksNeeded: number;
  lostLeads: number;
  spamFiltered: number;

  // Quality & scoring
  averageLeadScore: number;
  averageQualityScore: number;

  // Top lists
  mostRequestedServices: string[];
  mostCommonQuestions: string[];
  topLostLeadReasons: string[];

  // High tier additions
  outboundCallsAttempted?: number;
  outboundCallsAnswered?: number;
  bookingsFromOutbound?: number;
  optOutsThisWeek?: number;

  // Recommendations
  recommendations: string[];
}

/**
 * Build a complete weekly report for a single client.
 */
export async function generateWeeklyReport(client: ClientConfig): Promise<WeeklyReport> {
  const calls      = await getWeeksCalls(client.googleSheetId);
  const qualScores = await getWeekQualityScores(client.googleSheetId);
  const lostLeads  = await getWeekLostLeads(client.googleSheetId);

  const report: WeeklyReport = {
    report_id:             `WR-${client.businessId}-${Date.now()}`,
    week_ending:           getWeekEndingDate(),
    business_id:           client.businessId,
    business_name:         client.businessName,

    totalCalls:            calls.length,
    newLeads:              calls.filter(c => ['New Lead','High Intent Lead'].includes(c[COL.OUTCOME])).length,
    highIntentLeads:       calls.filter(c => c[COL.LEAD_PRIORITY] === 'Urgent' || c[COL.OUTCOME] === 'High Intent Lead').length,
    appointmentsRequested: calls.filter(c => c[COL.APPT_REQUESTED] === 'TRUE').length,
    calendlyLinksSent:     calls.filter(c => c[COL.CALENDLY_SENT] === 'TRUE').length,
    callbacksNeeded:       calls.filter(c => c[COL.CALLBACK_NEEDED] === 'TRUE').length,
    lostLeads:             lostLeads.length,
    spamFiltered:          calls.filter(c => c[COL.IS_SPAM] === 'TRUE').length,

    averageLeadScore:      average(calls.map(c => parseInt(c[COL.LEAD_SCORE] ?? '0', 10))),
    averageQualityScore:   average(qualScores.map(s => parseInt(s[COL_QS.OVERALL_SCORE] ?? '0', 10))),

    mostRequestedServices: topN(calls.map(c => c[COL.SERVICE_REQUESTED]).filter(Boolean), 5),
    mostCommonQuestions:   await getCommonQuestions(client.googleSheetId),
    topLostLeadReasons:    topN(lostLeads.map(l => l[COL_LL.REASON]).filter(Boolean), 3),

    recommendations: generateRecommendations(calls, lostLeads),
  };

  // High-tier additions
  if (client.tier === 'high' && client.outboundSales) {
    const outboundAttempts = await getWeekOutboundAttempts(client.googleSheetId);
    report.outboundCallsAttempted = outboundAttempts.length;
    report.outboundCallsAnswered  = outboundAttempts.filter(a => a[COL_OA.OUTCOME] !== 'No Answer').length;
    report.bookingsFromOutbound   = outboundAttempts.filter(a => a[COL_OA.OUTCOME] === 'Booked').length;
    report.optOutsThisWeek        = outboundAttempts.filter(a => a[COL_OA.OPT_OUT] === 'TRUE').length;
  }

  return report;
}

/**
 * Send formatted HTML weekly report email to the business owner.
 */
export async function sendWeeklyReportEmail(
  client: ClientConfig,
  report: WeeklyReport
): Promise<void> {
  const html = buildWeeklyReportHtml(report, client.tier);

  await sendEmail({
    to:      client.ownerEmail,
    subject: `📊 Weekly AI Agent Report — ${client.businessName} (Week ending ${report.week_ending})`,
    html,
  });

  console.log(`[weeklyReporter] Sent weekly report to ${client.ownerEmail}`);
}

/**
 * Save the weekly report record to the Weekly Reports tab.
 * Columns: report_id | week_ending | business_id | total_calls | new_leads |
 *          high_intent_leads | appointments_requested | calendly_links_sent |
 *          callbacks_needed | lost_leads | spam_filtered | avg_lead_score |
 *          avg_quality_score | top_services | recommendations
 */
export async function saveWeeklyReportToSheet(
  sheetId: string,
  report: WeeklyReport
): Promise<void> {
  const row = [
    report.report_id,
    report.week_ending,
    report.business_id,
    report.totalCalls,
    report.newLeads,
    report.highIntentLeads,
    report.appointmentsRequested,
    report.calendlyLinksSent,
    report.callbacksNeeded,
    report.lostLeads,
    report.spamFiltered,
    report.averageLeadScore,
    report.averageQualityScore,
    report.mostRequestedServices.join(', '),
    report.recommendations.join(' | '),
  ];

  await appendToSheet(sheetId, 'Weekly Reports', row);
}

// ── Column index constants ──────────────────────────────────────────────────────
// These match the Call Log tab column order
const COL = {
  OUTCOME:          8,
  LEAD_SCORE:       9,
  LEAD_PRIORITY:    10,
  SERVICE_REQUESTED:4,
  APPT_REQUESTED:   11,
  CALENDLY_SENT:    12,
  CALLBACK_NEEDED:  13,
  IS_SPAM:          14,
  CALL_DATE:        3,
};

const COL_QS = { OVERALL_SCORE: 16 };
const COL_LL = { REASON: 6 };
const COL_OA = { OUTCOME: 5, OPT_OUT: 8 };

// ── Internal helpers ──────────────────────────────────────────────────────────

async function getWeeksCalls(sheetId: string): Promise<string[][]> {
  const rows = await readSheetTab(sheetId, 'Call Log');
  const cutoff = getWeekStartDate();
  return (rows ?? []).slice(1).filter(row => {
    const d = new Date(row[COL.CALL_DATE]);
    return !isNaN(d.getTime()) && d >= cutoff;
  });
}

async function getWeekQualityScores(sheetId: string): Promise<string[][]> {
  try {
    const rows = await readSheetTab(sheetId, 'AI Quality Scores');
    return (rows ?? []).slice(1);
  } catch { return []; }
}

async function getWeekLostLeads(sheetId: string): Promise<string[][]> {
  try {
    const rows = await readSheetTab(sheetId, 'Lost Lead Alerts');
    return (rows ?? []).slice(1);
  } catch { return []; }
}

async function getWeekOutboundAttempts(sheetId: string): Promise<string[][]> {
  try {
    const rows = await readSheetTab(sheetId, 'Outbound Attempts');
    return (rows ?? []).slice(1);
  } catch { return []; }
}

async function getCommonQuestions(sheetId: string): Promise<string[]> {
  // Could read from a Questions log tab — returning placeholder for now
  return ['Hours of operation', 'Pricing', 'Service availability'];
}

function generateRecommendations(calls: string[][], lostLeads: string[][]): string[] {
  const recs: string[] = [];
  const total = calls.length;

  if (total === 0) return ['No calls this week — verify Twilio is connected.'];

  const lostRate = lostLeads.length / Math.max(total, 1);
  if (lostRate > 0.15) recs.push('High lost-lead rate — consider adding more Calendly prompts');

  const spamCount = calls.filter(c => c[COL.IS_SPAM] === 'TRUE').length;
  if (spamCount / total > 0.20) recs.push('High spam volume — review spam keywords list');

  const calendlyRate = calls.filter(c => c[COL.CALENDLY_SENT] === 'TRUE').length / total;
  if (calendlyRate < 0.25) recs.push('Calendly offer rate is low — verify agent prompt is triggering link offers');

  if (recs.length === 0) recs.push('Performance looks healthy — no changes recommended this week.');

  return recs;
}

function buildWeeklyReportHtml(report: WeeklyReport, tier: string): string {
  return `
<!DOCTYPE html>
<html>
<head><meta charset="utf-8"><style>
  body { font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; color: #333; }
  h1 { color: #1a1a2e; } h2 { color: #16213e; border-bottom: 1px solid #eee; padding-bottom: 8px; }
  .metric { display: inline-block; background: #f0f4ff; border-radius: 8px; padding: 12px 20px; margin: 6px; text-align: center; }
  .metric .value { font-size: 2em; font-weight: bold; color: #3a5bd9; }
  .metric .label { font-size: 0.8em; color: #666; }
  .rec { background: #fff8e1; border-left: 4px solid #f9a825; padding: 8px 12px; margin: 6px 0; border-radius: 4px; }
  table { width: 100%; border-collapse: collapse; } td, th { padding: 8px; border: 1px solid #ddd; }
  th { background: #f5f5f5; }
</style></head>
<body>
<h1>📊 Weekly AI Agent Report</h1>
<p><strong>${report.business_name}</strong> · Week ending ${report.week_ending}</p>

<h2>Call Summary</h2>
<div>
  <div class="metric"><div class="value">${report.totalCalls}</div><div class="label">Total Calls</div></div>
  <div class="metric"><div class="value">${report.newLeads}</div><div class="label">New Leads</div></div>
  <div class="metric"><div class="value">${report.highIntentLeads}</div><div class="label">High Intent</div></div>
  <div class="metric"><div class="value">${report.appointmentsRequested}</div><div class="label">Appts Requested</div></div>
  <div class="metric"><div class="value">${report.calendlyLinksSent}</div><div class="label">Calendly Sent</div></div>
  <div class="metric"><div class="value">${report.lostLeads}</div><div class="label">Lost Leads</div></div>
  <div class="metric"><div class="value">${report.spamFiltered}</div><div class="label">Spam Filtered</div></div>
</div>

<h2>Quality Scores</h2>
<table>
  <tr><th>Avg Lead Score</th><th>Avg Quality Score</th></tr>
  <tr><td>${report.averageLeadScore.toFixed(1)} / 100</td><td>${report.averageQualityScore.toFixed(1)} / 100</td></tr>
</table>

<h2>Top Services Requested</h2>
<ol>${report.mostRequestedServices.map(s => `<li>${s}</li>`).join('')}</ol>

${tier === 'high' && report.outboundCallsAttempted !== undefined ? `
<h2>Outbound Activity</h2>
<div>
  <div class="metric"><div class="value">${report.outboundCallsAttempted}</div><div class="label">Attempted</div></div>
  <div class="metric"><div class="value">${report.outboundCallsAnswered}</div><div class="label">Answered</div></div>
  <div class="metric"><div class="value">${report.bookingsFromOutbound}</div><div class="label">Booked</div></div>
  <div class="metric"><div class="value">${report.optOutsThisWeek}</div><div class="label">Opt-Outs</div></div>
</div>
` : ''}

<h2>Recommendations</h2>
${report.recommendations.map(r => `<div class="rec">${r}</div>`).join('')}

<p style="color:#999;font-size:0.8em;margin-top:30px;">Generated by Voice Agent · ${new Date().toISOString()}</p>
</body></html>`;
}

function getWeekStartDate(): Date {
  const d = new Date();
  d.setDate(d.getDate() - 7);
  d.setHours(0, 0, 0, 0);
  return d;
}

function getWeekEndingDate(): string {
  return new Date().toISOString().split('T')[0];
}
