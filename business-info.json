/**
 * utils.ts — Shared utility functions
 */

export function generateId(prefix: string = 'ID'): string {
  return `${prefix}-${Date.now()}-${Math.random().toString(36).substring(2, 7).toUpperCase()}`;
}

export function average(nums: number[]): number {
  const valid = nums.filter(n => !isNaN(n));
  if (valid.length === 0) return 0;
  return valid.reduce((a, b) => a + b, 0) / valid.length;
}

export function topN(items: string[], n: number): string[] {
  const counts: Record<string, number> = {};
  for (const item of items) {
    counts[item] = (counts[item] ?? 0) + 1;
  }
  return Object.entries(counts)
    .sort((a, b) => b[1] - a[1])
    .slice(0, n)
    .map(([key]) => key);
}

export function parsePhoneNumber(phone: string): string {
  return phone.replace(/\D/g, '');
}

export function sleep(ms: number): Promise<void> {
  return new Promise(resolve => setTimeout(resolve, ms));
}

export function formatCurrency(cents: number): string {
  return `$${(cents / 100).toFixed(2)}`;
}

export function toLocaleDateString(isoDate: string, timezone = 'America/Chicago'): string {
  return new Date(isoDate).toLocaleDateString('en-US', { timeZone: timezone });
}
