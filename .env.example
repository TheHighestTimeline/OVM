# SITE
SITE_URL=https://your-netlify-site.netlify.app
OVM_FROM_EMAIL=OneVibeMedia <hello@onevibemedia.shop>
OVM_INTERNAL_EMAIL=your-team@onevibemedia.shop
MOCK_MODE=true

# SIGNWELL
# Create a SignWell template with merge/API fields matching README.md.
SIGNWELL_API_KEY=
SIGNWELL_TEMPLATE_ID=
SIGNWELL_TEST_MODE=true
SIGNWELL_RECIPIENT_PLACEHOLDER=Client

# STRIPE
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# GOOGLE SHEETS
# Share the Google Sheet with the service account email.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB=Deals
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# EMAIL
# Optional: Resend API. If blank, the app logs/skips sending email.
RESEND_API_KEY=

# BANK TRANSFER DETAILS
BANK_ACCOUNT_NAME=OneVibeMediaGroup
BANK_NAME=Your Bank Name
BANK_ROUTING_NUMBER=000000000
BANK_ACCOUNT_NUMBER=0000000000
BANK_WIRE_DETAILS=Add your wire/ACH instructions here.
BANK_ZELLE_EMAIL=
BANK_MEMO_PREFIX=OVM

# ONBOARDING FORM
# Use a Tally link or your own onboarding page. Hidden fields are appended automatically.
ONBOARDING_FORM_URL=https://tally.so/r/YOUR_FORM_ID
