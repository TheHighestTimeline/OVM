# ── Clerk (auth) ─────────────────────────────────────────────────────────────
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# ── Airtable ──────────────────────────────────────────────────────────────────
# Personal Access Token from airtable.com/create/tokens
AIRTABLE_TOKEN=pat...
# Base ID from your Airtable base URL: airtable.com/YOUR_BASE_ID/...
AIRTABLE_BASE_ID=app...

# ── Anthropic (AI captions) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Google OAuth (Drive / Calendar) ──────────────────────────────────────────
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=https://your-site.netlify.app/.netlify/functions/google-accounts-oauth-callback

# ── Zapier — SMS reminders (5 min before scheduled post time) ─────────────────
# Create a Zap: Webhook trigger → SMS by Zapier (or Twilio) action
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/YOUR_HOOK_ID/

# ── CORS (optional) ───────────────────────────────────────────────────────────
# Comma-separated extra allowed origins (e.g. custom domain)
EXTRA_ALLOWED_ORIGINS=
