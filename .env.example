# ── Clerk (auth) ──────────────────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → your app → API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
CLERK_JWT_KEY=      # optional but recommended — paste the PEM public key for networkless JWT verification

# ── Supabase (posts, platform data, ads) ──────────────────────────────────────
# Get these from https://app.supabase.com → your project → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Airtable (client/artist records) ──────────────────────────────────────────
# Personal access token from https://airtable.com/create/tokens
AIRTABLE_TOKEN=pat...
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
# Table names (defaults shown — override if yours differ)
AIRTABLE_TABLE_CLIENTS=OVM Clients DB

# ── Anthropic (AI campaign builder + chat assistant) ──────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Google OAuth (Drive assets, Calendar) ─────────────────────────────────────
# Create OAuth credentials at https://console.cloud.google.com
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REDIRECT_URI=https://your-site.netlify.app/.netlify/functions/google-accounts-oauth-callback

# ── Notion (optional — if client records live in Notion instead of Airtable) ──
NOTION_TOKEN=secret_...

# ── CORS ──────────────────────────────────────────────────────────────────────
# Netlify sets $URL automatically for production. Add custom domains here.
# EXTRA_ALLOWED_ORIGINS=https://your-custom-domain.com

# Zapier — SMS reminders (5 min before scheduled post time)
# Create a Zapier webhook trigger → SMS by Zapier (or Twilio) action
# Paste the webhook URL here
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/YOUR_HOOK_ID/
